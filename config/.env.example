# AIO Environment Variables
# Copy this file to .env and fill in the values.

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Database (usually not needed if using docker-compose defaults)
# DATABASE_URL=postgresql+asyncpg://aio:aio@localhost:5432/aio
